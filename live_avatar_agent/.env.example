# GCP Project Configuration
GCP_PROJECT_ID=fabian-genai-bb
GCP_REGION=global
ENABLE_AVATAR=true

# Gemini Live API Configuration for Vertex AI
GEMINI_LIVE_API_URL=wss://global-aiplatform.googleapis.com/ws/google.cloud.aiplatform.v1.LlmBidiService/BidiGenerateContent

# Authentication
# Generate a short-lived token using Google Cloud Shell (if local gcloud is blocked by Context Aware Access):
#   gcloud auth print-access-token
GEMINI_BEARER_TOKEN=your_oauth_bearer_token_here

# Fallback for Google AI Studio
GEMINI_API_KEY=
